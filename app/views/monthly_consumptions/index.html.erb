<h1>Monthly Consumptions for <%= @customer.name %></h1>

<table>
  <thead>
    <tr>
      <th>Month</th>
      <th>Year</th>
      <th>Consumption</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @monthly_consumptions.each do |consumption| %>
      <tr>
        <td><%= consumption.month %></td>
        <td><%= consumption.year %></td>
        <td><%= consumption.consumption %></td>
        <td>
          <%= link_to 'Edit', edit_location_customer_monthly_consumption_path(@customer.location_id, @customer.id, consumption) %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= link_to 'Add Consumption', new_location_customer_monthly_consumption_path(@customer.location_id, @customer.id) %>
